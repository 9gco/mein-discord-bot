{
  "name": "@vybebot/eslint-plugin-discord",
  "version": "1.2.0",
  "description": "Type-aware ESLint rules for discord.js bots and Components V2",
  "type": "module",
  "author": "VybeBot <support@vybebot.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vybe-bot/eslint-plugin-discord.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "discordjs",
    "discord-bot",
    "vybebot"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "discord-check": "./bin/discord-check.cjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": ">=5.0.0"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.26.0",
    "@typescript-eslint/utils": "^8.26.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/rule-tester": "^8.26.0",
    "dedent": "^1.5.3",
    "discord.js": "^14.27.0",
    "eslint": "^9.22.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
